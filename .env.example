# ─────────────────────────────────────────────────────────────────────────────
# ALAAP — environment template
# Copy to server/.env (backend) and client/.env (frontend, VITE_* keys only).
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/alaap?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="4000"
CLIENT_URL="http://localhost:5173"
SERVER_URL="http://localhost:4000"

# ── Payments ────────────────────────────────────────────────────────────────
# PAYMENT_MODE=razorpay  → real Razorpay checkout (test or live keys)
# PAYMENT_MODE=mock      → built-in simulated gateway, DEVELOPMENT ONLY.
#                          The server refuses to boot with mock mode when
#                          NODE_ENV=production.
PAYMENT_MODE="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Frontend (client/.env) ──────────────────────────────────────────────────
VITE_API_URL="http://localhost:4000"
VITE_RAZORPAY_KEY_ID=""
