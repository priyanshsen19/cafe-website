# Template for the test environment. Copy to server/.env.test.
#
# The suite runs against a dedicated database so a test run can never touch
# development data:
#
#   createdb alaap_test
#   cd server && DATABASE_URL="<the URL below>" npx prisma db push
#
# These secrets are throwaway values used only to sign tokens during tests.
DATABASE_URL="postgresql://USER@localhost:5432/alaap_test?schema=public"

JWT_SECRET="test-secret-key-for-vitest-only-not-a-real-secret"
JWT_REFRESH_SECRET="test-refresh-secret-for-vitest-only-not-real"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

NODE_ENV="test"
PORT="4100"
CLIENT_URL="http://localhost:5173"
SERVER_URL="http://localhost:4100"

PAYMENT_MODE="mock"
